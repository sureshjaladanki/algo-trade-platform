{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Event Engine",
            "type": "debugpy",
            "request": "launch",
            "module": "src.strategy_service.engine",
            "console": "integratedTerminal",
            "args": []
        },
        {
            "name": "Python Debugger: VectorBT Engine",
            "type": "debugpy",
            "request": "launch",
            "module": "backtests.strategy_service.vectorbt_engine",
            "console": "integratedTerminal",
            "args": []
        },
        {
            "name": "Python Debugger: Current File (Module)",
            "type": "debugpy",
            "request": "launch",
            "module": "${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}