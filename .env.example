# Copy this file to .env and fill in secrets. .env is gitignored.
#
# P0 authorizes $0 paid data. A0.5 uses the official thetadata Python client and
# a free-account API key (no local Java terminal). Tiingo Starter ($0, 500
# symbols/mo) is the B0.5→B1 coverage probe for Yahoo-missing names, not a B1
# certification. CBOE SPX EOD is A1 only, after A0.5 greens. Norgate Platinum is
# B1 only, after B0.5 greens. No Polygon at P0.
#
# Broker calibration fills (200 tiny-size fills across SPY, one large cap, one
# mid cap, one SPX spread) are an operational P0 gate — not a vendor purchase.

# THETADATA_API_KEY=
# TIINGO_API_KEY=
# IBKR_ACCOUNT=
# IBKR_CLIENT_ID=
